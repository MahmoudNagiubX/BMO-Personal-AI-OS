# Copy to .env for local development. Never commit .env.
PAIOS_ENV=development
PAIOS_LOG_LEVEL=INFO
PAIOS_API_HOST=127.0.0.1
PAIOS_API_PORT=8000
PAIOS_EXTERNAL_ANALYTICS_ENABLED=false
PAIOS_CLOUD_MODELS_ENABLED=false
PAIOS_RAW_AUDIO_STORAGE_ENABLED=false
PAIOS_SCREEN_CAPTURE_STORAGE_ENABLED=false

# Development-only database placeholder. Replace locally; never reuse in production.
PAIOS_DATABASE_URL=postgresql+asyncpg://paios:paios_dev_only@127.0.0.1:5432/paios

# Model node. Keep Ollama on localhost or a trusted private interface.
PAIOS_OLLAMA_BASE_URL=http://127.0.0.1:11434
PAIOS_FAST_MODEL=qwen3.5:4b
PAIOS_MAIN_MODEL=qwen3.5:9b
PAIOS_EMBEDDING_MODEL=bge-m3
PAIOS_FAST_MODEL_CONTEXT=8192
PAIOS_MAIN_MODEL_CONTEXT=16384

# Device/event services — placeholders only.
PAIOS_MQTT_HOST=127.0.0.1
PAIOS_MQTT_PORT=1883
PAIOS_HOME_ASSISTANT_BASE_URL=http://127.0.0.1:8123
PAIOS_HOME_ASSISTANT_TOKEN=

# Authentication secrets must be generated locally in later phases.
PAIOS_DEVICE_TOKEN_SIGNING_KEY=
PAIOS_ENCRYPTION_KEY=
