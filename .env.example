# Copy to .env for local development. Never commit .env.
BMO_APP_NAME=BMO Personal AI OS
BMO_ENVIRONMENT=development
BMO_LOG_LEVEL=INFO
BMO_BUILD_SHA=unknown
BMO_DOCS_ENABLED=true
BMO_READINESS_TIMEOUT_SECONDS=1.0

# Development-only database placeholder. Never reuse it in production.
BMO_DATABASE_URL=postgresql+psycopg://bmo:bmo_dev_only@127.0.0.1:5432/bmo

# Optional local Compose overrides. These are not production credentials.
BMO_POSTGRES_DB=bmo
BMO_POSTGRES_USER=bmo
BMO_POSTGRES_PASSWORD=bmo_dev_only
BMO_POSTGRES_HOST_PORT=5432
